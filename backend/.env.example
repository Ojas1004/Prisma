# Groq (console.groq.com) — required
GROQ_API_KEY=
# Optional overrides — check console.groq.com/docs/models for the current catalog
#GROQ_BASE_URL=https://api.groq.com/openai/v1
#GROQ_CHAT_MODEL=openai/gpt-oss-120b
#GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Generation budget. The default chat model is a reasoning model — its thinking
# tokens share the completion budget, and in JSON mode a response truncated
# mid-document is rejected server-side as json_validate_failed with no content.
# The default is sized for high-effort reasoning plus a fully developed
# deliverable. If the account's per-minute token limit makes a request too
# large (413), the client automatically halves the reservation and retries.
#GROQ_MAX_TOKENS=8000

# Max source material per prompt, in characters (~4 chars/token). Longer
# documents (a research paper runs 30k+) are truncated at a paragraph break
# with a visible marker, since prompt + response must fit one rate-limit window.
#MAX_SOURCE_CHARS=14000
# low | medium | high — planning before writing keeps deliverables cohesive.
#GROQ_REASONING_EFFORT=high

# Postgres (docker-compose default)
DATABASE_URL=postgresql://sih:sih@localhost:5434/sih_transform

# Comma-separated origins, or * (default)
#CORS_ORIGINS=http://localhost:5173

# Supabase Auth (dashboard.supabase.com → Settings → API) — required for
# /api/auth routes. This project's own data still lives in Postgres via
# asyncpg (DATABASE_URL above); Supabase is used for auth only.
SUPABASE_URL=
# service_role key — server-side only, never exposed to the frontend.
SUPABASE_SERVICE_ROLE_KEY=